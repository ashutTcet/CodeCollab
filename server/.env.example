PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/codecollab
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1d

# Judge0 / sandbox execution configuration
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=replace_with_judge0_key_if_required
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_USER=
JUDGE0_POLL_INTERVAL_MS=900
JUDGE0_MAX_POLLS=18
JUDGE0_CPU_TIME_LIMIT=2
JUDGE0_WALL_TIME_LIMIT=5
JUDGE0_MEMORY_LIMIT_KB=131072

# AI Tutor configuration
# Groq (Primary recommended provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative provider options
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini
